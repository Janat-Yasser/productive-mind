<div class="page-header">
  <div class="page-header-left">
    <h1 class="page-title">Calendar</h1>
    <p class="page-sub">
      <%= startDate.toLocaleDateString('en-US',{month:'short',day:'numeric'}) %> –
      <%= endDate.toLocaleDateString('en-US',{month:'short',day:'numeric', year:'numeric'}) %>
    </p>
  </div>
  <div class="cal-nav">
    <a href="/calendar/day" class="btn-cal-view">Day</a>
    <a href="/calendar/week" class="btn-cal-view active">Week</a>
    <a href="/calendar" class="btn-cal-view">Month</a>
  </div>
</div>

<div class="cal-month-nav">
  <a href="/calendar/week?start=<%= prevStart %>" class="btn-cal-arrow">‹</a>
  <span class="cal-month-title">
    <%= startDate.toLocaleDateString('en-US',{month:'long', year:'numeric'}) %>
  </span>
  <a href="/calendar/week?start=<%= nextStart %>" class="btn-cal-arrow">›</a>
</div>

<div class="cal-week-grid">
  <% days.forEach(({date, tasks}) => { %>
    <% const isToday = date.toDateString() === today.toDateString(); %>
    <div class="cal-week-col <%= isToday ? 'week-today' : '' %>">
      <div class="cal-week-header">
        <span class="week-day-name"><%= date.toLocaleDateString('en-US',{weekday:'short'}) %></span>
        <span class="week-day-num <%= isToday ? 'today-num' : '' %>"><%= date.getDate() %></span>
      </div>
      <div class="cal-week-tasks">
        <% if (tasks.length === 0) { %>
          <div class="week-empty">—</div>
        <% } else { %>
          <% tasks.forEach(task => { %>
            <div class="week-task-card priority-border-<%= task.priority %>">
              <% if (task.dueTime) { %><span class="week-time"><%= task.dueTime %></span><% } %>
              <span class="week-task-title <%= task.status === 'done' ? 'strikethrough' : '' %>"><%= task.title %></span>
              <span class="task-cat cat-<%= task.category %>"><%= task.category %></span>
            </div>
          <% }) %>
        <% } %>
        <a href="/tasks/add" class="btn-week-add">+</a>
      </div>
    </div>
  <% }) %>
</div>
