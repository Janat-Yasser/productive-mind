<div class="page-header">
  <div class="page-header-left">
    <h1 class="page-title">Calendar</h1>
    <p class="page-sub"><%= date.toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric', year:'numeric'}) %></p>
  </div>
  <div class="cal-nav">
    <a href="/calendar/day" class="btn-cal-view active">Day</a>
    <a href="/calendar/week" class="btn-cal-view">Week</a>
    <a href="/calendar" class="btn-cal-view">Month</a>
  </div>
</div>

<div class="cal-month-nav">
  <a href="/calendar/day?date=<%= prevDay %>" class="btn-cal-arrow">‹</a>
  <span class="cal-month-title">
    <%= date.toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric'}) %>
  </span>
  <a href="/calendar/day?date=<%= nextDay %>" class="btn-cal-arrow">›</a>
</div>

<div class="cal-day-view">
  <% const hours = Array.from({length: 16}, (_, i) => i + 7); // 7am to 10pm %>
  <div class="day-timeline">
    <% hours.forEach(hour => { %>
      <% const h12 = hour > 12 ? hour - 12 : hour; %>
      <% const ampm = hour >= 12 ? 'PM' : 'AM'; %>
      <% const timeStr = `${String(hour).padStart(2,'0')}:00`; %>
      <% const slotTasks = tasks.filter(t => t.dueTime && t.dueTime.startsWith(String(hour).padStart(2,'0'))); %>
      <div class="timeline-row">
        <span class="timeline-hour"><%= h12 %> <%= ampm %></span>
        <div class="timeline-slot">
          <% slotTasks.forEach(task => { %>
            <div class="timeline-task priority-border-<%= task.priority %>">
              <span class="timeline-task-time"><%= task.dueTime %></span>
              <span class="timeline-task-title <%= task.status === 'done' ? 'strikethrough' : '' %>"><%= task.title %></span>
              <span class="task-cat cat-<%= task.category %>"><%= task.category %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>

  <% const untimed = tasks.filter(t => !t.dueTime); %>
  <% if (untimed.length > 0) { %>
    <div class="day-untimed">
      <h3 class="untimed-title">All Day / No Time</h3>
      <% untimed.forEach(task => { %>
        <div class="task-item <%= task.status %>">
          <div class="task-check-wrap">
            <button class="task-check <%= task.status === 'done' ? 'checked' : '' %>"
                    onclick="toggleStatus('<%= task._id %>', '<%= task.status %>')">
              <%= task.status === 'done' ? '✓' : '' %>
            </button>
          </div>
          <div class="task-body">
            <span class="task-title <%= task.status === 'done' ? 'strikethrough' : '' %>"><%= task.title %></span>
            <div class="task-meta">
              <span class="task-priority priority-<%= task.priority %>"><%= task.priority %></span>
              <span class="task-cat cat-<%= task.category %>"><%= task.category %></span>
            </div>
          </div>
          <div class="task-actions">
            <a href="/tasks/<%= task._id %>/edit" class="btn-icon">✏️</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (tasks.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🗓</div>
      <p>No tasks scheduled for this day.</p>
      <a href="/tasks/add" class="btn-primary-yellow">Add a Task</a>
    </div>
  <% } %>
</div>
