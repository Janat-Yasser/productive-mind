<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">
  <div class="app-shell">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <span class="logo-icon">🌀</span>
        <span class="logo-text">productive<br><strong>mind</strong></span>
      </div>

      <nav class="sidebar-nav">
        <a href="/tasks" class="nav-item <%= view === 'today' ? 'active' : '' %>">
          <span class="nav-icon">☀️</span>
          <span>Today</span>
        </a>
        <a href="/tasks/upcoming" class="nav-item <%= view === 'upcoming' ? 'active' : '' %>">
          <span class="nav-icon">📅</span>
          <span>Upcoming</span>
        </a>
        <a href="/tasks/utility" class="nav-item <%= view === 'utility' ? 'active' : '' %>">
          <span class="nav-icon">🗂</span>
          <span>Utility Hub</span>
        </a>
        <div class="nav-divider"></div>
        <a href="/calendar" class="nav-item <%= view === 'calendar' ? 'active' : '' %>">
          <span class="nav-icon">🗓</span>
          <span>Calendar</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="user-info">
          <div class="user-avatar"><%= user && user.name ? user.name[0].toUpperCase() : 'U' %></div>
          <div class="user-details">
            <span class="user-name"><%= user ? user.name : 'User' %></span>
            <span class="user-email"><%= user ? user.email : '' %></span>
          </div>
        </div>
        <form action="/auth/logout" method="POST" style="margin-top:12px">
          <button type="submit" class="btn-logout">Sign Out</button>
        </form>
      </div>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <% if (success_msg && success_msg.length > 0) { %>
        <div class="flash flash-success"><%= success_msg %></div>
      <% } %>
      <% if (error_msg && error_msg.length > 0) { %>
        <div class="flash flash-error"><%= error_msg %></div>
      <% } %>
      <%- body %>
    </main>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
