<div class="landing-page">
  <div class="landing-left">
    <div class="landing-logo">
      <span class="logo-emoji">🌀</span>
    </div>
    <div class="landing-fruit">
      <div class="fruit-item fruit-1">🍋</div>
      <div class="fruit-item fruit-2">🌶</div>
      <div class="fruit-item fruit-3">🍊</div>
    </div>
    <div class="landing-copy">
      <h1 class="landing-headline">Productive<br><em>Mind</em></h1>
      <p class="landing-sub">Own your day. Master every moment.</p>
      <div class="landing-actions">
        <a href="/auth/signup" class="btn-primary-yellow">Get Started Free</a>
        <a href="/auth/signin" class="btn-ghost-light">Sign In</a>
      </div>
    </div>
  </div>
  <div class="landing-right">
    <div class="preview-card">
      <div class="preview-header">
        <span class="preview-dot red"></span>
        <span class="preview-dot yellow"></span>
        <span class="preview-dot green"></span>
        <span class="preview-title">Today</span>
      </div>
      <div class="preview-tasks">
        <div class="preview-task done"><span class="pt-check">✓</span><span>Morning workout</span></div>
        <div class="preview-task done"><span class="pt-check">✓</span><span>Review project proposal</span></div>
        <div class="preview-task active"><span class="pt-check active-dot"></span><span>Team standup at 10am</span><span class="pt-badge high">High</span></div>
        <div class="preview-task"><span class="pt-check empty"></span><span>Write weekly report</span><span class="pt-badge medium">Med</span></div>
        <div class="preview-task"><span class="pt-check empty"></span><span>Review budget spreadsheet</span></div>
        <div class="preview-task"><span class="pt-check empty"></span><span>Evening run</span><span class="pt-badge low">Low</span></div>
      </div>
      <div class="preview-footer">
        <span>3 / 6 complete</span>
        <div class="preview-progress"><div class="preview-bar" style="width:50%"></div></div>
      </div>
    </div>
  </div>
</div>
