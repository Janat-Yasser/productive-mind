<div class="auth-page">
  <div class="auth-left">
    <a href="/" class="auth-logo">
      <span>🌀</span>
      <span>Productive Mind</span>
    </a>
    <div class="auth-fruit">
      <div class="fruit-float">🍋</div>
      <div class="fruit-float" style="animation-delay:.4s">🌶</div>
      <div class="fruit-float" style="animation-delay:.8s">🍊</div>
    </div>
    <p class="auth-tagline">Own your day.<br>Master every moment.</p>
  </div>
  <div class="auth-right">
    <div class="auth-card">
      <h2 class="auth-title">Sign In</h2>
      <p class="auth-desc">Welcome back. Let's get productive.</p>

      <% if (error && error.length > 0) { %>
        <div class="flash flash-error"><%= error %></div>
      <% } %>
      <% if (error_msg && error_msg.length > 0) { %>
        <div class="flash flash-error"><%= error_msg %></div>
      <% } %>
      <% if (success_msg && success_msg.length > 0) { %>
        <div class="flash flash-success"><%= success_msg %></div>
      <% } %>

      <form action="/auth/signin" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@email.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn-primary-yellow btn-full">Sign In →</button>
      </form>

      <p class="auth-switch">Don't have an account? <a href="/auth/signup">Create one</a></p>
    </div>
  </div>
</div>
